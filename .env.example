# PostgreSQL connection (local development)
DATABASE_URL=postgresql://waline:waline@localhost:5432/walinex?schema=public
SHADOW_DATABASE_URL=postgresql://waline:waline@localhost:5432/walinex_shadow?schema=public

# Docker Compose PostgreSQL container (production)
POSTGRES_USER=waline
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=walinex

# Redis for queues, rate limiting, and caching
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=true

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ROOT_DOMAIN=waline.infvar.com
NEXT_PUBLIC_INSTANCE_DOMAIN=instance.waline.infvar.com
APP_ENCRYPTION_KEY=please-generate-a-32-byte-random-key
SESSION_SECRET=please-generate-a-random-session-secret
CAP_SECRET=please-generate-a-32-byte-cap-secret
APP_PORT=3000

# OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=无尽书证 <noreply@waline.infvar.com>
EMAIL_WORKER_CONCURRENCY=4

# Seed admin account (optional; the user still signs in with GitHub/Google)
ADMIN_EMAIL=
ADMIN_NAME=

# Optional Akismet / AI moderation defaults
AKISMET_API_KEY=
AI_MODERATION_BASE_URL=https://api.openai.com/v1
AI_MODERATION_MODEL=gpt-4o-mini
AI_MODERATION_API_KEY=
